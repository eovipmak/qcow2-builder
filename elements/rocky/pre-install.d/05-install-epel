#!/bin/bash

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

# ncdu lives in EPEL on Rocky/Alma. package-installs runs after this hook
# (pre-install.d < install.d < post-install.d), so epel-release must be in
# place before package-installs resolves `ncdu`.
# Mirror the main repos the same way 00-set-rocky-mirror does when a custom
# mirror is configured, so epel-release install does not depend on the
# default upstream mirrorlist.
dnf -y install epel-release

# Do not point EPEL at DIB_DISTRIBUTION_MIRROR: the ctrliq GCP Rocky mirror
# does not host an EPEL tree (/pub/rocky/8/ has no epel/ directory), so any
# baseurl override there 404s. EPEL therefore keeps its stock epel.repo
# metalink/mirrorlist which resolves upstream.

