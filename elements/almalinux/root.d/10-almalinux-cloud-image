#!/bin/bash

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

[ -n "${ARCH:-}" ]
[ -n "${TARGET_ROOT:-}" ]

case "$DIB_RELEASE" in
    8|9)
        ;;
    *)
        echo "Unsupported AlmaLinux release: $DIB_RELEASE" >&2
        exit 1
        ;;
esac

case "$ARCH" in
    amd64|x86_64)
        ARCH=x86_64
        ;;
    arm64|aarch64)
        ARCH=aarch64
        ;;
    ppc64le|s390x)
        ;;
    *)
        echo "AlmaLinux root element does not support architecture: $ARCH" >&2
        exit 1
        ;;
esac

DIB_LOCAL_IMAGE=${DIB_LOCAL_IMAGE:-}

if [ -n "$DIB_LOCAL_IMAGE" ]; then
    IMAGE_LOCATION="$DIB_LOCAL_IMAGE"
    CACHED_IMAGE="$IMAGE_LOCATION"
    BASE_IMAGE_FILE="$(basename "$DIB_LOCAL_IMAGE")"
else
    DIB_CLOUD_IMAGES=${DIB_CLOUD_IMAGES:-https://repo.almalinux.org/almalinux/${DIB_RELEASE}/cloud/${ARCH}/images}
    BASE_IMAGE_FILE=${BASE_IMAGE_FILE:-AlmaLinux-${DIB_RELEASE}-GenericCloud-latest.${ARCH}.qcow2}
    IMAGE_LOCATION="${DIB_CLOUD_IMAGES}/${BASE_IMAGE_FILE}"
    CACHED_IMAGE="${DIB_IMAGE_CACHE}/${BASE_IMAGE_FILE}"
fi

BASE_IMAGE_TAR="${BASE_IMAGE_FILE}.tgz"
PATCHED_EXTRACT_IMAGE="$(mktemp)"
sed \
    -e '/-s LABEL -p/a\
                part_label=$(sudo blkid -o value -s PART_ENTRY_NAME -p "${LOOPDEV}" 2>/dev/null)' \
    -e 's/if \[\[ \${part_type} == \${GUID_LINUX_BOOT} || \${label} == "boot" \]\]; then/if [[ \${part_type} == \${GUID_LINUX_BOOT} || \${label} == "boot" || \${part_label} == "boot" ]]; then/' \
    -e '/            if \[ ! -z "\$EFI_LOOPDEV" \]; then/i\            sudo mkdir -p "$WORKING/mnt/boot/efi"' \
    "$TMP_HOOKS_PATH/bin/extract-image" > "$PATCHED_EXTRACT_IMAGE"
chmod +x "$PATCHED_EXTRACT_IMAGE"
"$PATCHED_EXTRACT_IMAGE" "$BASE_IMAGE_FILE" "$BASE_IMAGE_TAR" "$IMAGE_LOCATION" "$CACHED_IMAGE"
rm -f "$PATCHED_EXTRACT_IMAGE"
