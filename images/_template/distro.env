# Debian|Ubuntu|Rocky|Fedora|CentOS root element name
DISTRO=<name>
# bookworm|noble|9-stream|41 ...
DIB_RELEASE=<release>
# Debian-family (UEFI + Secure Boot):
#   "debian vm block-device-efi cloud-init grub2 dhcp-all-interfaces <custom>"
#   "ubuntu vm block-device-efi cloud-init grub2 dhcp-all-interfaces <custom>"
# RHEL-family: e.g. "rocky vm cloud-init" (`DIB_RELEASE=9-stream`),
#   "fedora vm cloud-init" (`DIB_RELEASE=41`); add dhcp-all-interfaces there too
# Notes:
#  - `vm` ALONE falls back to block-device-mbr (BIOS). `block-device-efi`
#    gives GPT + ESP (/boot/efi), no LVM, no swap.
#  - `grub2` pulls the signed grub/shim packages required for Secure Boot
#    (mapped per-distro in the <custom> element's pkg-map; see
#    elements/debian-12/pkg-map).
#  - `autoupdates` is NOT a builtin in DIB 3.29; this repo vendors it at
#    `elements/autoupdates/` (see its README for the delta vs upstream). It
#    installs unattended-upgrades (Debian family) or dnf-automatic (RHEL
#    family) and enables the schedule that actually applies them.
#  - `dhcp-all-interfaces` is what gives the booted guest an IP. Without it a
#    Debian debootstrap root has only `lo` in /etc/network/interfaces, so the
#    documented SSH boot-test silently fails (no route, no banner).
DIB_ELEMENTS="<distro-element> vm block-device-efi cloud-init grub2 dhcp-all-interfaces autoupdates"
# e.g. ubuntu-24.04
OUTPUT=<name>
TYPE=qcow2
ARCH=amd64
# Extra packages via -p, or leave empty and use an element's package-installs.yaml
PACKAGES=""
# Space-separated custom elements, resolved via ELEMENTS_PATH=elements
CUSTOM_ELEMENTS=""
# Patch policy for the autoupdates element. Debian family: point
# DIB_DEB_UPDATES_CONF at a 50unattended-upgrades file (host-side path;
# REPO_ROOT comes from scripts/common.sh, which exports it):
DIB_DEB_UPDATES_CONF="$REPO_ROOT/images/<name>/50unattended-upgrades"
# RHEL family: set DIB_YUM_UPDATES_CONF to a dnf automatic.conf instead, and
# leave DIB_DEB_UPDATES_CONF unset. Setting both fails the build.
# DIB_YUM_UPDATES_CONF="$REPO_ROOT/images/<name>/automatic.conf"
SSH_PORT=2222
VNC_DISPLAY=:5
MEM_MB=2048
SMP=2
# UEFI boot-test firmware. Set both to boot the VM under OVMF with Secure
# Boot; leave empty ("") to boot legacy BIOS. `boot_vm()` copies
# UEFI_VARS_TEMPLATE to build/<output>/OVMF_VARS.fd (writable per-VM store).
# Debian/Ubuntu (ovmf pkg):
UEFI_CODE=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
UEFI_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
# RHEL-family (edk2-ovmf pkg):
# UEFI_CODE=/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd
# UEFI_VARS_TEMPLATE=/usr/share/edk2/ovmf/OVMF_VARS.fd
