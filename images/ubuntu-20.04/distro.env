DISTRO=ubuntu
DIB_RELEASE=focal
# ubuntu              = cloud-image root element (focal = 20.04 LTS)
# vm                  = partitionable disk image
# block-device-efi    = GPT + ESP (/boot/efi); no LVM, no swap (vm alone = MBR/BIOS)
# cloud-init          = install + enable cloud-init
# grub2               = signed grub-efi-amd64-signed + shim-signed (Secure Boot)
# dhcp-all-interfaces = DHCP on every NIC at boot; without it the guest has no IP
#                       and the documented `ssh -p 2222 root@localhost` cannot work
# autoupdates         = unattended-upgrades + APT::Periodic keys, security-only
#                       (vendored, not in DIB 3.29 — see elements/autoupdates/README.md)
# ubuntu-20.04        = this repo's element (elements/ubuntu-20.04): packages, TZ, root SSH
DIB_ELEMENTS="ubuntu vm block-device-efi cloud-init grub2 dhcp-all-interfaces autoupdates ubuntu-20.04 motd"
OUTPUT=ubuntu-20.04
TYPE=qcow2
ARCH=amd64
PACKAGES=""
CUSTOM_ELEMENTS=""
# 50unattended-upgrades policy injected by the autoupdates element
# (host-side path; REPO_ROOT comes from scripts/common.sh). Exported by
# load_distro(). RHEL-family equivalent: DIB_YUM_UPDATES_CONF.
DIB_DEB_UPDATES_CONF="$REPO_ROOT/images/ubuntu-20.04/50unattended-upgrades"
SSH_PORT=2222
VNC_DISPLAY=:5
MEM_MB=2048
SMP=2
# UEFI Secure Boot firmware for boot-vm.sh. The .ms vars template ships the MS
# key database with Secure Boot already activated.
UEFI_CODE=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
UEFI_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
