DISTRO=debian
DIB_RELEASE=bullseye
# debian              = debootstrap root element (bullseye)
# vm                  = partitionable disk image
# block-device-efi    = GPT + ESP (/boot/efi); no LVM, no swap (vm alone = MBR/BIOS)
# cloud-init          = install + enable cloud-init
# grub2               = signed grub-efi-amd64-signed + shim-signed (Secure Boot)
# dhcp-all-interfaces = DHCP on every NIC at boot; without it the guest has no IP
#                       and the documented `ssh -p 2222 root@localhost` cannot work
# debian-11           = this repo's element (elements/debian-11): packages, TZ, root SSH
# NOTE: no `autoupdates` element on 11 — bullseye is EOL and bullseye-security
# is unusable (stale index vs pruned pool → 404 on +deb11u1 debs), so there is
# no security suite to auto-apply. 12/13 keep it.
DIB_ELEMENTS="debian vm block-device-efi cloud-init grub2 dhcp-all-interfaces debian-11"
OUTPUT=debian-11
TYPE=qcow2
ARCH=amd64
PACKAGES=""
CUSTOM_ELEMENTS=""
# DIB 3.29's debian-minimal defaults still list bullseye-backports, which was
# removed from the main mirror (404). Drop that suite; keep main/updates.
# No security line: bullseye is EOL and bullseye-security's pool is pruned
# (index still pins +deb11u1 debs that 404), so apt would fail the build.
DIB_APT_SOURCES_CONF="default:deb http://deb.debian.org/debian bullseye main
updates:deb http://deb.debian.org/debian bullseye-updates main
"
SSH_PORT=2222
VNC_DISPLAY=:5
MEM_MB=2048
SMP=2
# UEFI Secure Boot firmware for boot-vm.sh. The .ms vars template ships the MS
# key database with Secure Boot already activated.
UEFI_CODE=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
UEFI_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
