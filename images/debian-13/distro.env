DISTRO=debian
DIB_RELEASE=trixie
# debian              = debootstrap root element (trixie)
# vm                  = partitionable disk image
# block-device-efi    = GPT + ESP (/boot/efi); no LVM, no swap (vm alone = MBR/BIOS)
# cloud-init          = install + enable cloud-init
# grub2               = signed grub-efi-amd64-signed + shim-signed (Secure Boot)
# dhcp-all-interfaces = DHCP on every NIC at boot; without it the guest has no IP
#                       and the documented `ssh -p 2222 root@localhost` cannot work
# autoupdates         = unattended-upgrades + APT::Periodic keys, security-only
#                       (vendored, not in DIB 3.29 — see elements/autoupdates/README.md)
# debian-13           = this repo's element (elements/debian-13): packages, TZ, root SSH
DIB_ELEMENTS="debian vm block-device-efi cloud-init grub2 dhcp-all-interfaces autoupdates debian-13"
OUTPUT=debian-13
TYPE=qcow2
ARCH=amd64
PACKAGES=""
CUSTOM_ELEMENTS=""
# 50unattended-upgrades policy injected by the autoupdates element
# (host-side path; REPO_ROOT comes from scripts/common.sh). Exported by
# load_distro(). RHEL-family equivalent: DIB_YUM_UPDATES_CONF.
DIB_DEB_UPDATES_CONF="$REPO_ROOT/images/debian-13/50unattended-upgrades"
# DIB 3.29's debian-minimal defaults predate trixie: its security line still
# points at the old `trixie/updates` suite path (404). Override the full
# sources map; load_distro() exports this and environment.d leaves it alone.
DIB_APT_SOURCES_CONF="default:deb http://deb.debian.org/debian trixie main
backports:deb http://deb.debian.org/debian trixie-backports main
updates:deb http://deb.debian.org/debian trixie-updates main
security:deb http://security.debian.org/debian-security trixie-security main
"
SSH_PORT=2222
VNC_DISPLAY=:5
MEM_MB=2048
SMP=2
# UEFI Secure Boot firmware for boot-vm.sh. The .ms vars template ships the MS
# key database with Secure Boot already activated.
UEFI_CODE=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
UEFI_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
